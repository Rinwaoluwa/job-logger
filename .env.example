PORT=8787
HOST=127.0.0.1
# Set ALLOW_REMOTE=1 to bind HOST to something other than 127.0.0.1/localhost.
ALLOW_REMOTE=0

# Path to the claude CLI binary. Defaults to "claude" (resolved via PATH),
# falling back to ~/.local/bin/claude if that lookup fails.
CLAUDE_BIN=claude
# Model used for analysis/critique/fit/extraction calls (fast, cheap, low effort).
CLAUDE_MODEL=sonnet
# Model used for résumé/cover-letter/answer writing (higher quality).
CLAUDE_MODEL_WRITE=opus
# Reasoning effort (low|medium|high|xhigh) for the résumé draft and rewrite
# calls only. Higher is slower per call; the draft and each rewrite are
# given 8 minutes.
CLAUDE_EFFORT_WRITE=high

# Background tasks. Every generation (prepare application, interview prep,
# answer, fit, add job by link, sources refresh) runs as a task you can watch
# in the top-bar activity panel. TASK_CONCURRENCY is how many run at once;
# CLAUDE_CONCURRENCY caps live `claude` CLI processes across all of them
# (your subscription rate-limits, so more parallelism means more failed
# calls); CHROME_CONCURRENCY caps overlapping headless-Chrome page
# measurements (each is a whole browser).
TASK_CONCURRENCY=3
CLAUDE_CONCURRENCY=3
CHROME_CONCURRENCY=2

# Page budget the tailor pipeline holds a résumé to. If a draft runs longer,
# the pipeline asks for a trim and re-measures instead of shipping the overrun,
# and as a last resort steps the font down from 10pt to 9.5pt.
RESUME_MAX_PAGES=1
# Truth and JD-fit reviewer: a second model reads each résumé draft and
# reports claims the profile does not support and plan items not shown.
# Set to 0 to skip it.
RESUME_REVIEWER=1
# Model for the reviewer (defaults to CLAUDE_MODEL). A different model from
# the writer gives an independent read.
# CLAUDE_MODEL_REVIEW=sonnet
# RESUME_REVIEWER_EFFORT=medium
# A rewrite pass (fixing what the checks and the reviewer flagged, or
# trimming to the page) returns a patch of the changed bullets by default,
# which the app merges: about 2k output tokens instead of the whole résumé
# again (about 11k, 70 s). "full" restores the old whole-résumé rewrite.
# RESUME_REWRITE_MODE=patch
# Browser used to measure the résumé's page count (the downloadable PDF is
# written with pdfkit, not Chrome). Leave unset to auto-detect Chrome,
# Chromium, Edge or Brave; measurement falls back to an estimate if none
# is found.
# CHROME_BIN=

# "Find people" (the People tab). A multi-round web-search agent: each round
# is one claude call with WebSearch/WebFetch, and the loop runs again while a
# role target (1 hiring manager, 2 recruiters, 3 peers) is short, up to
# PEOPLE_MAX_ROUNDS rounds or PEOPLE_MAX_COST_USD in total per search. Opus
# keeps searching where Sonnet stops after a handful of queries.
# PEOPLE_MODEL=opus
# PEOPLE_EFFORT=high
# PEOPLE_MAX_COST_USD=6
# PEOPLE_ROUND_BUDGET_USD=2.5
# PEOPLE_MAX_ROUNDS=3
# A round that hits this limit is lost (the CLI returns nothing when
# killed), so the prompt tells the model to finish well before it; a deep
# Opus round with LinkedIn pages runs 6-20 minutes.
# PEOPLE_ROUND_TIMEOUT_S=1500
# A round is one call per role still short (hiring manager, recruiters,
# peers), run in parallel: three claude processes at once, which is all of
# CLAUDE_CONCURRENCY=3, so other tasks queue behind a running people search.
# Raise CLAUDE_CONCURRENCY to 4-5 if that bites.
# LinkedIn, read while signed in through a Chrome profile of the app's own
# (People tab → Connect LinkedIn signs it in once). Automated reading of
# LinkedIn is against its terms and can get the account restricted; set
# PEOPLE_LINKEDIN=0 to search public pages only. The server keeps one
# browser for all the parallel calls of a search; LINKEDIN_MAX_PAGES caps
# LinkedIn page loads per search (all rounds and calls together).
# PEOPLE_LINKEDIN=1
# LINKEDIN_PROFILE_DIR=data/chrome-linkedin
# LINKEDIN_MAX_PAGES=20

# Adzuna (https://developer.adzuna.com) — free app id/key, used for the CA/US job search adapter.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

DB_PATH=data/app.db
SOURCES_CONFIG=config/sources.json
