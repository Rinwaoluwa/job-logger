{
  "name": "job-match-filter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c red,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "profile:check": "node --disable-warning=ExperimentalWarning server/profile/check.js",
    "sources:refresh": "node --disable-warning=ExperimentalWarning server/scripts/refresh.js",
    "db:reset": "rm -f data/app.db data/app.db-shm data/app.db-wal",
    "lint": "eslint src server shared",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsdom": "^25.0.1",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
